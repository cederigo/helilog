// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Import {
  id          Int      @id @default(autoincrement())
  format      String
  description String?
  rawDataPath String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models Model[]
  flights     Flight[]
  batteries   Battery[]
}

model Model {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  maintenanceInterval Float?
  lastMaintenance     DateTime?
  importId     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  import       Import?           @relation(fields: [importId], references: [id], onDelete: Cascade)
  flights      Flight[]
  maintenance  MaintenanceRecord[]

  @@index([name])
	@@map("Model")
}

model Flight {
  id           Int      @id @default(autoincrement())
  modelId Int 
  date         DateTime
  duration     Int      // in seconds
  minVoltage   Float? // minimum voltage during flight
  maxCurrent   Float? // maximum current during flight
  maxPower   Float? // maximum power during flight
  chargeUsed Float? // mAh consumed during flight
  maxRPM       Int?   // maximum headspeed during flight
  importId     Int?
  batteryId    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  model       Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  import       Import?    @relation(fields: [importId], references: [id], onDelete: Cascade)
  battery      Battery?   @relation(fields: [batteryId], references: [id], onDelete: SetNull)
  telemetry    FlightTelemetryPoint[]

  @@index([modelId])
  @@index([date])
  @@index([batteryId])
}

model FlightTelemetryPoint {
  id         Int      @id @default(autoincrement())
  flightId   Int
  timestamp  DateTime
  current    Float    // A
  voltage    Float    // V
  chargeUsed Float    // mAh consumed
  headspeed  Int      // RPM
  pwm        Int      // throttle %
  temp       Float    // °C

  flight     Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId])
}

model Battery {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  capacity  Int      // mAh
  cells     Int      // number of cells
  importId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  import    Import?  @relation(fields: [importId], references: [id], onDelete: Cascade)
  flights   Flight[]
}

model MaintenanceRecord {
  id           Int      @id @default(autoincrement())
  modelId Int 
  date         DateTime
  description  String
  hoursAtMaintenance Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  model  Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([date])
}
